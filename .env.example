NODE_ENV=development
APP_URL=http://localhost:3000
# Must match APP_URL pathname. Rebuild the web image after changing it.
NEXT_PUBLIC_BASE_PATH=
DATABASE_URL=postgresql://emailsystem:change-me@localhost:5432/emailsystem
REDIS_URL=redis://localhost:6379
# Generate each independently: openssl rand -hex 32
SESSION_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
ALLOW_MOCK_PROVIDER=false
WORKER_CONCURRENCY=4
MAX_IMPORT_ROWS=100000
MAX_UPLOAD_BYTES=10000000
ACTIVITY_RETENTION_DAYS=90
ATTEMPT_RETENTION_DAYS=365
WEBHOOK_RETENTION_DAYS=30
EXPERIMENT_EVIDENCE_RETENTION_DAYS=365
EXPERIMENT_MESSAGE_RETENTION_DAYS=30
# Docker production only
DOMAIN=mail.example.com
POSTGRES_PASSWORD=

CLICK_ANALYTICS_RETENTION_DAYS=90
TRACKING_LINK_LIFETIME_DAYS=180
EMAILBLAST_PORT=3087
