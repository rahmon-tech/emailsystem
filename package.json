{
  "name": "emailsystem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @emailsystem/web dev",
    "worker": "node --import tsx apps/worker/main.ts",
    "build": "pnpm db:generate && pnpm --filter @emailsystem/web build",
    "build:native": "pnpm build && node --import tsx scripts/prepare-standalone.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages tests scripts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 --test-timeout=120000 tests/integration/*.test.ts",
    "test:coverage": "node --import tsx --experimental-test-coverage --test --test-coverage-include='packages/core/src/**/*.ts' --test-coverage-include='packages/providers/src/**/*.ts' --test-coverage-include='packages/email/src/**/*.ts' tests/*.test.ts",
    "test:integration:coverage": "node --import tsx --experimental-test-coverage --test --test-concurrency=1 --test-timeout=120000 --test-coverage-include='packages/core/src/**/*.ts' --test-coverage-include='packages/providers/src/**/*.ts' --test-coverage-include='packages/email/src/**/*.ts' tests/integration/*.test.ts",
    "coverage:critical": "pnpm test:coverage && pnpm test:integration:coverage",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "bootstrap:native": "node --import tsx scripts/native-bootstrap.ts",
    "bootstrap:native:check": "node --import tsx scripts/native-bootstrap.ts --check-only",
    "user:create": "node --import tsx scripts/create-user.ts",
    "providers:bootstrap": "node --import tsx scripts/providers-bootstrap.ts",
    "secrets:scan": "node --import tsx scripts/secret-scan.ts",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "secrets:scan:history": "node --import tsx scripts/secret-scan.ts --history"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1127.0",
    "@codemirror/lang-html": "6.4.12",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/material-nextjs": "9.4.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tiptap/extension-color": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@uiw/react-codemirror": "4.25.11",
    "bullmq": "6.3.4",
    "csv-parse": "7.0.2",
    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "html-to-text": "10.0.1",
    "htmlparser2": "12.0.0",
    "ioredis": "6.0.0",
    "ipaddr.js": "2.5.0",
    "juice": "12.1.2",
    "next": "16.3.4",
    "nodemailer": "10.0.1",
    "pg": "8.23.0",
    "postcss": "8.5.28",
    "prisma": "7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.17.7",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/html-to-text": "9.0.4",
    "@types/node": "26.5.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/sanitize-html": "2.16.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
